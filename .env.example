# ==============================================================================
# Mei-Kaappan — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to:
#   - `.env.local` for local frontend development
#   - Set appropriate variables in your deployment platforms (Vercel, Railway, Docker, AWS, etc.)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# Application branding and metadata
NEXT_PUBLIC_APP_NAME="Mei-Kaappan"
NEXT_PUBLIC_APP_SUBTITLE="Intelligent Scam Prevention & Protection System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Data Source Mode:
#   - "live": Connects client-side actions to the Spring Boot REST API & PostgreSQL
#   - "demo": Uses in-memory mock repository for stand-alone UI previews
NEXT_PUBLIC_DATA_SOURCE="live"
NEXT_PUBLIC_DEMO_MODE="false"

# Java Spring Boot REST API Base URL
# Local development:
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"
# Production example:
# NEXT_PUBLIC_API_BASE_URL="https://api.meikaappan.yourdomain.org/api/v1"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_MAX_PAYMENT_CHECK_AMOUNT="500000"


# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Java Spring Boot REST API)
# ------------------------------------------------------------------------------
# HTTP Server Port
SERVER_PORT=8080

# PostgreSQL Connection Properties (Local Development Defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meikaappan_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternatively, configure via standard Spring JDBC URL (e.g., Supabase / RDS / Neon):
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host.com:5432/meikaappan_db?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins:
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://meikaappan.yourdomain.org"

# Flyway Database Migrations
# When true, Spring Boot automatically migrates the database schema on boot
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
