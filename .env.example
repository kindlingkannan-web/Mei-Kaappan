# Environment Variables Template for Mei-Kaappan
# Web Application Deployment Configuration

NEXT_PUBLIC_APP_NAME="Mei-Kaappan"
NEXT_PUBLIC_APP_SUBTITLE="Intelligent Scam Prevention & Protection System"
NEXT_PUBLIC_APP_VERSION="1.0.0-prototype"

# Mode: "demo" (local mock adapter) or "live" (Spring Boot REST API)
NEXT_PUBLIC_DATA_SOURCE="demo"
NEXT_PUBLIC_DEMO_MODE="true"

# Java Spring Boot API Gateway (when deployed / running locally)
# Default local Spring Boot server URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"

# Client Security & Rate Limits (Placeholders for deployment)
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_MAX_PAYMENT_CHECK_AMOUNT="500000"
